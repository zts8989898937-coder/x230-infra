[Unit]
Description=ttyd web terminal (behind webterm proxy)
After=network.target

[Service]
User=zts
ExecStart=/home/zts/.local/bin/ttyd -p 3901 -i 127.0.0.1 -b /tty -H X-Auth-User -W -a -t titleFixed="X230 Terminal" -t fontSize=15 -t rendererType=canvas /home/zts/agent-share/webterm/ttyd-session.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
