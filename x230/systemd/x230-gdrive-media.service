[Unit]
Description=X230 weekly incremental sync of photos-by-date & Music to Google Drive
After=network-online.target boot-network-guard.service
Wants=boot-network-guard.service

[Service]
Type=oneshot
User=zts
Environment=HOME=/home/zts
ExecStart=/usr/local/bin/x230-gdrive-media.sh
TimeoutStartSec=12h
Nice=15
IOSchedulingClass=idle
