[Unit]
Description=phone-upload — 手机浏览器上传照片到 X230（:8900）
After=network-online.target

[Service]
Type=simple
User=zts
Environment=HOME=/home/zts
Environment=PATH=/home/zts/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/zts/.local/bin/phone-upload --port 8900
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
