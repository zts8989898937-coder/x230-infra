[Unit]
Description=Live AI quota & Clash telemetry daemon (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zts
Group=zts
Environment=HOME=/home/zts
Environment=HTTPS_PROXY=http://127.0.0.1:7897
Environment=HTTP_PROXY=http://127.0.0.1:7897
WorkingDirectory=/home/zts/agent-share/webterm
ExecStart=/usr/bin/node /home/zts/agent-share/webterm/quota-live-server.js
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
