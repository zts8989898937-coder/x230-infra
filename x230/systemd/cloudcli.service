[Unit]
Description=CloudCLI web UI (Codex / Claude Code)
After=network-online.target

[Service]
Type=simple
User=zts
WorkingDirectory=/home/zts/apps/cloudcli
Environment=VITE_IS_PLATFORM=true
Environment=HOST=127.0.0.1
EnvironmentFile=-/home/zts/.config/cloudcli.env
Environment=PORT=3001
Environment=HOME=/home/zts
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/zts/.local/bin
ExecStart=/usr/bin/node /home/zts/apps/cloudcli/node_modules/.bin/cloudcli
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
