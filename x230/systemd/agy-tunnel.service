[Unit]
Description=Reverse SSH tunnel HK 18899 to X230 agy-bridge 8899
After=network-online.target agy-bridge.service
Wants=network-online.target agy-bridge.service

[Service]
User=zts
Environment=HOME=/home/zts
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o ConnectTimeout=10 -R 127.0.0.1:18899:127.0.0.1:8899 hk
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
