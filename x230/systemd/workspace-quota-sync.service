[Unit]
Description=Sync AI subscription quota JSON to HK workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zts
Group=zts
Environment=HOME=/home/zts
Environment=HTTPS_PROXY=http://127.0.0.1:7897
Environment=HTTP_PROXY=http://127.0.0.1:7897
WorkingDirectory=/home/zts/agent-share/webterm
ExecStart=/usr/bin/node /home/zts/agent-share/webterm/quota-sync.js
TimeoutStartSec=90
Nice=10
