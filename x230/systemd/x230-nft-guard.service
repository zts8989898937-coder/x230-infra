[Unit]
Description=X230 additive host input guard (non-disruptive to Docker/Tailscale/WG)
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables-x230-guard.conf
ExecReload=/usr/sbin/nft -f /etc/nftables-x230-guard.conf
ExecStop=/usr/sbin/nft delete table inet x230_guard

[Install]
WantedBy=multi-user.target
