[Unit]
Description=VS Code Web (code serve-web) - 浏览器里的 VS Code
Documentation=https://code.visualstudio.com/docs/remote/vscode-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zts
Group=zts
Environment=HOME=/home/zts
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /home/zts/.vscode/cli/serve-web/c4453f8ea430795f941c1b2ff6c9321135a74a02/out/server-main.js --host 127.0.0.1 --port 8443 --server-base-path /code --connection-token-file /home/zts/.config/secrets/code-web-token --accept-server-license-terms
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
