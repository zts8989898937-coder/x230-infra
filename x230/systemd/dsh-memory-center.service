[Unit]
Description=DSH Memory Center (ChatGPT-style local memory manager)
After=network.target

[Service]
Type=simple
User=zts
Group=zts
WorkingDirectory=/home/zts
Environment=DSH_MEMORY_DIR=/home/zts/.dsh/memories
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/zts/.local/bin/dsh-memory-center --host 0.0.0.0 --port 3099
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/zts/.dsh/memories /home/zts/.config/secrets
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
