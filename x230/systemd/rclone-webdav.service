[Unit]
Description=rclone WebDAV bridge for Google Drive (AList backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zts
EnvironmentFile=/etc/rclone-webdav.env
Environment=HTTPS_PROXY=http://127.0.0.1:7897
Environment=HTTP_PROXY=http://127.0.0.1:7897
Environment=NO_PROXY=127.0.0.1,localhost
ExecStart=/usr/bin/rclone serve webdav gdrive: --addr 172.17.0.1:8898 --user ${RCLONE_WEBDAV_USER} --pass <REDACTED> --read-only --config /home/zts/.config/rclone/rclone.conf --log-level INFO
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
