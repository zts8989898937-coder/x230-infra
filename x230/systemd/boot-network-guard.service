[Unit]
Description=X230 post-boot network, Clash TUN, AI node pin & egress risk-control gate
After=NetworkManager.service clash-verge-service.service hk-direct-route.service
Wants=clash-verge-service.service hk-direct-route.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/boot-network-guard
TimeoutStartSec=75

[Install]
WantedBy=multi-user.target
