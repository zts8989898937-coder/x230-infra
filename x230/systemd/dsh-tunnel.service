[Unit]
Description=Reverse SSH tunnel HK 19080 to X230 dsh-web
After=network-online.target dsh-web.service
Wants=network-online.target

[Service]
User=zts
Environment=HOME=/home/zts
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o ConnectTimeout=10 -R 127.0.0.1:19080:100.110.77.111:3080 hk
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
