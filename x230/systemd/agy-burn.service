[Unit]
Description=agy-burn — 每天跑满 Antigravity(Google AI Pro) 额度
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zts
Environment=HOME=/home/zts
Environment=PATH=/home/zts/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/zts/.local/bin/agy-burn
Nice=10
TimeoutStartSec=7200
