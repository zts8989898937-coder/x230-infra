[Unit]
Description=Direct route to HK server (bypass mihomo TUN)
After=network-pre.target
Before=network-online.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/hk-direct-route.sh up
ExecStop=/usr/local/bin/hk-direct-route.sh down

[Install]
WantedBy=multi-user.target
