#!/usr/bin/env bash
# browse — 一次性无头浏览器：打开页面 → 截图/取文本 → 进程退出
# 不常驻：内存只在运行的那几秒里占用；登录态保存在磁盘 profile，进程关了也不丢。
#
# 用法:
#   browse <url>                    截图到 ~/browse-shots/
#   browse <url> -o out.png         指定输出
#   browse <url> -W 1440 -H 900     视口尺寸
#   browse <url> -w 6000            等待预算(ms)，慢页面/动画页调大
#   browse <url> -t                 不截图，输出渲染后的纯文本
#   browse <url> --gpu              尝试 GPU 渲染（默认 SwiftShader，更稳）
#   browse <url> -p /tmp/prof       用临时 profile（不污染登录态）
#
# 退出码: 0 成功 / 2 用法错 / 3 profile 被占用 / 4 浏览器失败 / 5 产物无效
set -uo pipefail

CHROME=${BROWSE_CHROME:-/usr/bin/chromium}
PROFILE=${BROWSE_PROFILE:-$HOME/.dsh/browser-profile}
OUTDIR=${BROWSE_OUTDIR:-$HOME/browse-shots}
W=1440; H=900; BUDGET=4000; TEXT=0; GPU=0; QUIET=0; OUT=""; URL=""

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0
fi

while [ $# -gt 0 ]; do
  case "$1" in
    -o) OUT=${2:?}; shift 2 ;;
    -W) W=${2:?}; shift 2 ;;
    -H) H=${2:?}; shift 2 ;;
    -w) BUDGET=${2:?}; shift 2 ;;
    -p) PROFILE=${2:?}; shift 2 ;;
    -t) TEXT=1; shift ;;
    --gpu) GPU=1; shift ;;
    -q) QUIET=1; shift ;;
    -*) echo "未知选项: $1" >&2; exit 2 ;;
    *) URL=$1; shift ;;
  esac
done

[ -n "$URL" ] || { echo "缺少 URL" >&2; exit 2; }
case "$URL" in
  http://*|https://*|file://*|data:*) ;;
  *) URL="https://$URL" ;;
esac
[ -x "$CHROME" ] || { echo "找不到浏览器: $CHROME" >&2; exit 4; }

mkdir -p "$PROFILE" "$OUTDIR" 2>/dev/null
exec 9>"$PROFILE/.browse.lock"
flock -w 30 9 || { echo "profile 被另一个 browse 占用: $PROFILE" >&2; exit 3; }

FLAGS=(--headless=new --no-first-run --no-default-browser-check --hide-scrollbars
       --disable-extensions --disable-background-networking --disable-sync
       --disable-default-apps --disable-features=Translate,OptimizationHints
       --user-data-dir="$PROFILE" --window-size="$W,$H"
       --virtual-time-budget="$BUDGET" --run-all-compositor-stages-before-draw)
[ "$GPU" = 1 ] && FLAGS+=(--enable-gpu --use-angle=gl)

START=$(date +%s%N)
if [ "$TEXT" = 1 ]; then
  DOM=$(timeout 90 "$CHROME" "${FLAGS[@]}" --dump-dom "$URL" 2>/dev/null)
  RC=$?
  [ $RC -eq 0 ] && [ -n "$DOM" ] || { echo "渲染失败 (rc=$RC)" >&2; exit 4; }
  printf '%s' "$DOM" | python3 -c '
import sys,re
from html.parser import HTMLParser
class P(HTMLParser):
    def __init__(s): super().__init__(); s.skip=0; s.o=[]
    def handle_starttag(s,t,a):
        if t in ("script","style","noscript"): s.skip+=1
        if t in ("p","div","br","li","h1","h2","h3","h4","tr","section","article"): s.o.append("\n")
    def handle_endtag(s,t):
        if t in ("script","style","noscript"): s.skip=max(0,s.skip-1)
    def handle_data(s,d):
        if not s.skip: s.o.append(d)
p=P(); p.feed(sys.stdin.read())
t="".join(p.o)
t=re.sub(r"[ \t]+"," ",t); t=re.sub(r"\n\s*\n+","\n",t)
print(t.strip())'
  exit $?
fi

if [ -z "$OUT" ]; then
  HOST=$(printf '%s' "$URL" | sed -E 's#^[a-z]+://##; s#[/:?].*##' | tr -c 'A-Za-z0-9.-' '_')
  OUT="$OUTDIR/$(date +%Y%m%d-%H%M%S)-${HOST:-page}.png"
fi
case "$OUT" in /*) ;; *) OUT="$PWD/$OUT" ;; esac
rm -f "$OUT"

timeout 90 "$CHROME" "${FLAGS[@]}" --screenshot="$OUT" "$URL" >/dev/null 2>&1
RC=$?
ELAPSED=$(( ( $(date +%s%N) - START ) / 1000000 ))

[ -s "$OUT" ] || { echo "截图失败 (rc=$RC)，页面可能超时或崩溃" >&2; exit 4; }
SIZE=$(stat -c%s "$OUT")
[ "$SIZE" -gt 1024 ] || { echo "产物过小 (${SIZE}B)，渲染异常" >&2; exit 5; }
read -r PW PH <<<"$(python3 - "$OUT" <<'PY'
import struct,sys
d=open(sys.argv[1],'rb').read(33)
print(*(struct.unpack('>II', d[16:24]) if d[:8]==b'\x89PNG\r\n\x1a\n' else (0,0)))
PY
)"
[ "$PW" -gt 0 ] || { echo "不是有效 PNG: $OUT" >&2; exit 5; }

if [ "$QUIET" = 0 ]; then
  printf '✓ %sx%s · %s KB · %ss\n  %s\n' "$PW" "$PH" "$((SIZE/1024))" "$(awk -v m=$ELAPSED 'BEGIN{printf "%.1f", m/1000}')" "$OUT"
fi
echo "$OUT"
exit 0
