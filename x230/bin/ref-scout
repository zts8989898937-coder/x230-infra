#!/usr/bin/env bash
# ref-scout — 视觉任务开工前的参考采集
#
# 用法:
#   ref-scout <slug> <url> [url...]      抓桌面(1440x900)+手机(390x844)两版
#   ref-scout -t <slug> <url>...         只抓桌面（快速筛）
#
# 产物: 工作产出/02-设计稿/参考采集/<YYYYMMDD>-<slug>/
#        01-<host>.png / 01-<host>-m.png ... + index.md（待填「可借的点」）
# 退出码: 0 有至少一张有效图 / 1 全部失败 / 2 用法错
set -uo pipefail

ROOT=/home/zts/agent-share/工作产出/02-设计稿/参考采集
PROF=/home/zts/agent-share/工作产出/06-临时中转/$(date +%Y%m%d)/refprof
MOBILE=1; SLUG=""; URLS=()

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -t) MOBILE=0; shift ;;
    -*) echo "未知选项: $1" >&2; exit 2 ;;
    *) if [ -z "$SLUG" ]; then SLUG=$1; else URLS+=("$1"); fi; shift ;;
  esac
done

[ -n "$SLUG" ] && [ ${#URLS[@]} -gt 0 ] || { echo "用法: ref-scout <slug> <url>..." >&2; exit 2; }

DATE=$(date +%Y%m%d)
OUT="$ROOT/$DATE-$SLUG"
mkdir -p "$OUT" "$PROF"

ok=0; i=0; rows=()
for u in "${URLS[@]}"; do
  i=$((i+1))
  host=$(printf '%s' "$u" | sed -E 's#^https?://##; s#/.*$##; s#^www\.##' | tr -c 'a-zA-Z0-9.-' '-')
  num=$(printf '%02d' "$i")
  f="$OUT/$num-$host.png"
  echo "→ [$num] $u"
  note=""; sz=0
  if browse "$u" -o "$f" -W 1440 -H 900 -w 7000 -p "$PROF" -q 2>/dev/null; then
    sz=$(stat -c%s "$f" 2>/dev/null || echo 0)
    if [ "$sz" -lt 20000 ]; then
      echo "   ⚠ 只有 ${sz}B，可能白屏/被挡（WebGL 站常这样，换源或试 --gpu）"
      note="⚠ 疑似白屏"
    else
      ok=$((ok+1))
    fi
  else
    echo "   ✗ 抓取失败"; note="✗ 抓取失败"; f=""
  fi
  if [ "$MOBILE" = 1 ] && [ -n "$f" ]; then
    browse "$u" -o "$OUT/$num-$host-m.png" -W 390 -H 844 -w 7000 -p "$PROF" -q 2>/dev/null || true
  fi
  rows+=("| $num | $u | ![s]($num-$host.png) | $note |  |")
done

{
  echo "# 参考采集 · $DATE · $SLUG"
  echo
  echo "抓取时间：$(date '+%Y-%m-%d %H:%M')　来源：ref-scout"
  echo
  echo "| # | 网址 | 截图 | 状态 | 可借的点 / 成本 |"
  echo "|---|---|---|---|---|"
  printf '%s\n' "${rows[@]}"
  echo
  echo "## 怎么用"
  echo
  echo "1. 圈一个编号（可加「备选」一个），一句话说哪儿对 / 哪儿不对。"
  echo "2. 选定后写冻结卡（参考图 + 验收标准 + 不做清单），再开工。"
  echo "3. 选中的图进 \`02-设计稿/参考库/\` 并打标签，下次先查库再上网。"
} > "$OUT/index.md"

echo
echo "产物: $OUT"
echo "有效: $ok/${#URLS[@]}"
[ "$ok" -gt 0 ] || exit 1
