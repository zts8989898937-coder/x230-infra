#!/usr/bin/env bash
set -u
LOG=/home/zts/.local/state/dsh-finalmerge.log
ST=/home/zts/.dsh/storages
SRC=/home/zts/.dsh/_retired/workspace.final.json
BUCKET=/home/zts/.dsh/sessions/--home-zts-agent-share-~5BF9~8BDD--
mkdir -p "$(dirname "$LOG")"
log(){ echo "[$(date '+%F %T')] $*" >>"$LOG"; }
cnt(){ python3 -c "import json;d=json.load(open('$ST/workspace.json'));print(len(list(d['tables']['workspaces'].values())[0]['sessionIds']))" 2>/dev/null; }
log "=== 单工作区合并收尾开始 ==="
cp -a "$ST/workspace.json" "$ST/workspace.json.bak-final-$(date +%Y%m%d-%H%M%S)" && log "已备份当前归属表"
systemctl stop dsh-web && log "dsh-web 已停"
chown -R zts:zts "$BUCKET" && log "属主已校正"
cp "$SRC" "$ST/workspace.json" && log "已写入归属表: $(cnt) 条会话 / 1 个工作区"
systemctl start dsh-web && log "dsh-web 已启动"
ok=0
for i in $(seq 1 25); do
  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' http://100.110.77.111:3080/ 2>/dev/null)
  [ "$code" = "401" ] && { log "健康检查通过 (第 ${i} 次)"; ok=1; break; }
  sleep 2
done
sleep 20
n=$(cnt)
f=$(journalctl -u dsh-web --since "-2min" --no-pager 2>/dev/null | grep -c "filtered session")
log "启动后归属数=${n} 被过滤告警=${f}"
if [ "$ok" != "1" ] || [ "$n" != "59" ]; then
  log "自检未通过，回滚"
  systemctl stop dsh-web
  cp -a "$(ls -t "$ST"/workspace.json.bak-final-* | head -1)" "$ST/workspace.json"
  systemctl start dsh-web
  log "=== 已回滚 ==="
  exit 1
fi
log "=== 完成 ==="
