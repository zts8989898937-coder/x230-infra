#!/usr/bin/env python3
# claim-check：交付/记忆写入前自查「断言越权」。启发式，只提示不改写。
# 用法：claim-check 文件   |   pbpaste | claim-check
import sys, re
ABS = re.compile(r"实测|已验证|已核实|跑通了|确认了|根因|必然|一定|一律|永远|绝对不会|不可能|全都")
EV  = re.compile(r"```|\$ |→|退出码|输出|日志|返回|命令|实测值|\d+\.\d+\.\d+|:[0-9]{4}")
def scan(text):
    hits=[]
    for para in re.split(r"\n\s*\n", text):
        if not ABS.search(para): continue
        if EV.search(para): continue
        s=para.strip().replace("\n"," ")
        hits.append(s[:160])
    return hits
text = open(sys.argv[1],encoding="utf-8").read() if len(sys.argv)>1 else sys.stdin.read()
h=scan(text)
if not h:
    print("OK 未发现无证据的强断言"); sys.exit(0)
print(f"发现 {len(h)} 处强断言但同段没有命令/输出/版本号等证据，改成「推测/待验证」或补证据：\n")
for x in h: print(" -",x)
sys.exit(1)
