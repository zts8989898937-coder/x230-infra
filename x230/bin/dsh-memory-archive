#!/usr/bin/env bash
# dsh-memory-archive — 记忆与会话的保留策略（只增不改，先归档再删）
#
# 2026-11-09 四域审计 P2：
#   - daily 日志只增不减（11 个文件 248K，无归档策略）
#   - ~/.dsh/sessions 78M / 137 个会话，没有保留期
# 做法：超过阈值的条目先打成 tar.zst 放进 archive 目录，校验通过才删原件。
# 每日日志 60 天、会话 90 天。默认 dry-run 之外才动文件。
#
# 用法：dsh-memory-archive [--dry-run] [--daily-days N] [--session-days N]
set -uo pipefail
DAILY_DAYS=60
SESSION_DAYS=90
DRY=0
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    --daily-days) shift ;;
    --daily-days=*) DAILY_DAYS=${a#*=} ;;
    --session-days) shift ;;
    --session-days=*) SESSION_DAYS=${a#*=} ;;
  esac
done
MEM="$HOME/.dsh/memories"
SES="$HOME/.dsh/sessions"
STAMP="$(date +%Y%m)"
say() { echo "$@"; }
run() { if [ "$DRY" = 1 ]; then say "[dry] $*"; else eval "$@"; fi; }

moved_daily=0; moved_ses=0
DAILY_ARCH="$MEM/daily-archive/$STAMP"
SES_ARCH="$SES-archive/$STAMP"

# 1) daily：按文件名日期判断（YYYY-MM-DD.md），比 mtime 稳
cutoff=$(date -d "-${DAILY_DAYS} days" +%Y-%m-%d)
for f in "$MEM"/daily/*.md; do
  [ -e "$f" ] || continue
  d=$(basename "$f" .md)
  [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || continue
  [ "$d" \< "$cutoff" ] || continue
  say "归档 daily $d"
  run "mkdir -p '$DAILY_ARCH'"
  run "cp -a '$f' '$DAILY_ARCH/' && rm -f '$f'"
  moved_daily=$((moved_daily+1))
done

# 2) sessions：整个 session-<id> 目录打包归档
if [ -d "$SES" ]; then
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    name=$(basename "$dir")
    say "归档会话 $name（$(date -d @"$(stat -c %Y "$dir")" +%F)）"
    run "mkdir -p '$SES_ARCH'"
    run "tar --zstd -cf '$SES_ARCH/$name.tar.zst' -C '$(dirname "$dir")' '$name'"
    # 校验归档里至少有 session 数据再删
    run "tar --zstd -tf '$SES_ARCH/$name.tar.zst' | grep -q 'session.v4.jsonl.zstd' && rm -rf '$dir'"
    moved_ses=$((moved_ses+1))
  done < <(find "$SES" -maxdepth 2 -mindepth 2 -type d -name 'session-*' -mtime "+$SESSION_DAYS" 2>/dev/null)
fi

if [ "$DRY" = 1 ]; then say "完成（dry-run）：daily $moved_daily 个，会话 $moved_ses 个，未改动文件"; else say "完成：daily $moved_daily 个，会话 $moved_ses 个"; fi
exit 0
