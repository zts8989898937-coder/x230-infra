#!/usr/bin/env bash
# dsh-skill-explorer-lan-trust-verify — 证明技能中心在「局域网 Authority」下真的通了，
# 而不只是回环。做法与浏览器一致：从 journal 取 launch token → 换 dsh-auth cookie →
# 带 Host: 192.0.2.30:3082 调 /api/dsh-skill-explorer/list。
# 结果追加到 ~/.local/state/dsh-skill-explorer-patch/verify.log；200 才算通过。
set -u
URL="http://192.0.2.20:3080"
HOSTHDR="192.0.2.30:3082"
STATE_DIR="/home/zts/.local/state/dsh-skill-explorer-patch"
LOG="$STATE_DIR/verify.log"
mkdir -p "$STATE_DIR" 2>/dev/null

token=$(sudo journalctl -u dsh-web --no-pager -n 4000 2>/dev/null | grep -oE "token=[A-Za-z0-9_-]+" | tail -1)
if [ -z "${token:-}" ]; then
  echo "[$(date '+%F %T')] verify: no launch token in journal" >>"$LOG"
  exit 2
fi

jar=$(mktemp)
trap 'rm -f "$jar"' EXIT

token_code=$(curl -s -m 10 -c "$jar" -o /dev/null -w '%{http_code}' -H "Host: $HOSTHDR" "$URL/?$token")
shell_code=$(curl -s -m 10 -b "$jar" -o /dev/null -w '%{http_code}' -H "Host: $HOSTHDR" "$URL/")
api_raw=$(curl -s -m 10 -b "$jar" -w '\n%{http_code}' -H "Host: $HOSTHDR" "$URL/api/dsh-skill-explorer/list")
api_code=$(printf '%s' "$api_raw" | tail -n1)
api_body=$(printf '%s' "$api_raw" | sed '$d' | cut -c1-140)

line="[$(date '+%F %T')] token=$token_code shell=$shell_code skills_api=$api_code body=$api_body"
echo "$line" >>"$LOG"
echo "$line"

if [ "$api_code" = "200" ]; then
  echo "PASS: skill center reachable over LAN authority ($HOSTHDR)"
  exit 0
fi
echo "FAIL: skill center still refused over LAN authority (see $LOG)"
exit 1
